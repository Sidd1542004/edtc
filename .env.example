# Public site URL, used for canonical links, Open Graph and the sitemap.
VITE_SITE_URL=https://edtc.ai

# Contact form endpoint. Receives a JSON POST. Leave empty until a form service or API is connected.
# While empty, the form validates but tells the visitor their message was NOT sent and offers email instead.
VITE_CONTACT_ENDPOINT=

# URL of the existing AI Readiness Check service. Leave empty to show the page without the tool.
VITE_READINESS_CHECK_URL=

# Show editorial markers for content that still needs EDTC confirmation (true for review builds only).
VITE_SHOW_EDITORIAL=false
